rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin','owner','property manager'];
    }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /issues/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
    match /recurringTasks/{id} { allow read: if signedIn(); allow create, update, delete: if isAdmin(); }
    match /bills/{id} { allow read: if isAdmin(); allow create, update, delete: if isAdmin(); }
    match /expenses/{id} { allow read: if isAdmin(); allow create, update, delete: if isAdmin(); }
  }
}